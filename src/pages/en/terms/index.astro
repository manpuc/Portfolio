---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="Overview | manpuc" lang="en">
    <div class="container">
        <div class="back-nav animate-fade-up">
            <a href="/en/" class="back-link">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
                        points="12 19 5 12 12 5"></polyline></svg
                >
                Back to Home
            </a>
        </div>

        <header style="flex-direction: column; gap: 0.5rem; padding-bottom: 0; margin-bottom: 1rem;">
            <h1 style="margin-bottom: 0;">Overview</h1>
            <p class="subtitle" style="margin-top: 0;">Terms of Service & Privacy Policy</p>
        </header>

        <section class="terms-section">
            <div id="page-1" class="page-content animate-fade-up" style="display: block;">
                <div class="neumorph-card">
                    <h2 style="font-size: 1.8rem; margin-bottom: 2rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--text-muted); color: var(--text-color);">Terms of Service</h2>

                    <section style="margin-bottom: 2rem;">
                        <h2>Article 1 (Applicability)</h2>
                        <p>
                            These terms set forth the conditions for using this
                            portfolio website (the "Site") and the contents provided by
                            the creator "manpuc" (the "Creator"). By using this Site,
                            users are deemed to have agreed to these terms.
                        </p>
                    </section>

                    <section style="margin-bottom: 2rem;">
                        <h2>Article 2 (Prohibited Actions)</h2>
                        <p>
                            Users shall not engage in the following acts when using the
                            Site:
                        </p>
                        <ul>
                            <li>
                                Acts that interfere with or may interfere with the
                                operation of the Site.
                            </li>
                            <li>
                                Acts that infringe on the intellectual property rights,
                                such as copyrights or trademarks, of the Creator or any
                                third party.
                            </li>
                            <li>
                                Unauthorized access or acts that disrupt the functions
                                of the Site's servers or networks.
                            </li>
                            <li>
                                Commercial use (redistribution, resale, etc.) of the
                                Site's content without the Creator's permission.
                            </li>
                            <li>
                                Other acts that violate laws and regulations or public
                                order and morals.
                            </li>
                        </ul>
                    </section>

                    <section style="margin-bottom: 2rem;">
                        <h2>Article 3 (Disclaimer)</h2>
                        <p>
                            The Creator does not guarantee the accuracy, completeness,
                            or up-to-dateness of the information posted on the Site.
                        </p>
                        <p>
                            The Creator shall not be liable for any damage (direct or
                            indirect) caused by the use of the Site. Use of the
                            published source code or software is at your own risk.
                        </p>
                    </section>

                    <section style="margin-bottom: 2rem;">
                        <h2>Article 4 (Copyright)</h2>
                        <p>
                            The copyright of all content on this Site (text, images,
                            published code, etc.) belongs to the Creator unless
                            otherwise specified. Unauthorized reproduction, reprinting,
                            modification, or distribution beyond the scope of private
                            use is prohibited.
                        </p>
                    </section>

                    <section>
                        <h2>Article 5 (Changes to Terms)</h2>
                        <p>
                            The Creator may change these terms at any time without
                            notice if deemed necessary. The changed terms shall be
                            effective from the time they are posted on the Site.
                        </p>
                    </section>
                </div>
            </div>

            <div id="page-2" class="page-content animate-fade-up" style="display: none;">
                <div class="neumorph-card">
                    <h2 style="font-size: 1.8rem; margin-bottom: 2rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--text-muted); color: var(--text-color);">Privacy Policy</h2>

                    <section style="margin-bottom: 2rem;">
                        <h2>Data Collection and Processing</h2>
                        <p>
                            This site is a static portfolio website. We do not collect, transmit, or store any user input or personal data on our servers. Inquiries are handled directly via your own email client.
                        </p>
                    </section>

                    <section style="margin-bottom: 2rem;">
                        <h2>Access Analytics</h2>
                        <p>
                            This site uses "Cloudflare Web Analytics" and a self-hosted "Umami" analytics instance to understand site usage and improve user experience. These tools do not use cookies for tracking and collect statistical information completely anonymously. No personally identifiable information is collected or shared with third parties.
                        </p>
                    </section>

                    <section style="margin-bottom: 2rem;">
                        <h2>Local Storage</h2>
                        <p>
                            To improve user convenience, this site uses your browser's localStorage strictly to save your theme preference (light/dark mode). This data remains locally on your device and is never transmitted to any external server.
                        </p>
                    </section>

                    <section style="margin-bottom: 2rem;">
                        <h2>Disclaimer</h2>
                        <p>
                            We take no responsibility for the information, services, etc., provided on external sites accessed via links from this site.
                        </p>
                    </section>

                    <section>
                        <h2>Changes to Privacy Policy</h2>
                        <p>
                            We will review and improve this policy from time to time. The revised Privacy Policy shall become effective as soon as it is posted on this site.
                        </p>
                    </section>
                </div>
            </div>

            <div class="pagination-container" id="pagination-container">
                <button class="pagination-btn active" data-page="1">1</button>
                <button class="pagination-btn" data-page="2">2</button>
            </div>
        </section>
    </div>

    <style is:global>
        .pagination-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1.2rem;
            margin-top: 3.5rem;
            flex-wrap: wrap;
        }
        .pagination-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: var(--text-muted);
            border: none;
            font-family: inherit;
            font-size: 1.05rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            padding: 0.2rem 0.5rem;
        }
        .pagination-btn:hover:not(:disabled) {
            color: var(--text-color);
        }
        .pagination-btn.active {
            color: var(--primary);
            font-weight: 700;
        }
        .pagination-btn.active::after {
            content: "";
            position: absolute;
            bottom: -4px;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            height: 2px;
            background-color: var(--primary);
            border-radius: 2px;
        }
        .pagination-btn:disabled {
            opacity: 0.2;
            cursor: not-allowed;
        }
    </style>

    <script is:inline>
        document.addEventListener("astro:page-load", initTermsPagination);
        if (!document.documentElement.dataset.astroPageLoad) {
            initTermsPagination();
        }

        function initTermsPagination() {
            const btns = document.querySelectorAll('.pagination-btn');
            const page1 = document.getElementById('page-1');
            const page2 = document.getElementById('page-2');
            const section = document.querySelector(".terms-section");

            if (!btns.length || !page1 || !page2 || !section) return;

            btns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const targetPage = e.target.dataset.page;
                    
                    // Update buttons
                    btns.forEach(b => b.classList.remove('active'));
                    e.target.classList.add('active');

                    // 変更前の高さを取得
                    const oldHeight = section.offsetHeight;

                    // Update content
                    if (targetPage === '1') {
                        page1.style.display = 'block';
                        page2.style.display = 'none';
                    } else {
                        page1.style.display = 'none';
                        page2.style.display = 'block';
                    }

                    // アニメーション再発火
                    const activePage = targetPage === '1' ? page1 : page2;
                    activePage.style.animation = "none";
                    activePage.offsetHeight; // リフローを強制
                    activePage.style.animation = "";

                    // 高さが変わる場合は滑らかにアニメーション（フッターがカクッと動くのを防ぐ）
                    section.style.height = "auto";
                    const newHeight = section.offsetHeight;

                    if (oldHeight !== newHeight && oldHeight > 0) {
                        section.style.height = oldHeight + "px";
                        section.style.overflow = "hidden";
                        section.offsetHeight; // リフロー

                        section.style.transition =
                            "height 0.4s cubic-bezier(0.25, 1, 0.5, 1)";
                        section.style.height = newHeight + "px";

                        setTimeout(() => {
                            section.style.transition = "";
                            section.style.height = "auto";
                            section.style.overflow = "visible";
                        }, 400);
                    }

                    // Smooth scroll to top of section
                    if (section) {
                        const rect = section.getBoundingClientRect();
                        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                        window.scrollTo({
                            top: rect.top + scrollTop - 80,
                            behavior: "smooth",
                        });
                    }
                });
            });
        }
    </script>
</Layout>
