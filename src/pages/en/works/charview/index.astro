---
import Layout from "../../../../layouts/Layout.astro";
import { works } from "../../../../data/works";

const charviewWork = works.find((w) => w.id === "CharView");
const chromeWebStoreUrl = charviewWork?.href || "https://chromewebstore.google.com/detail/lgiilinkfchechjoaeojckghoamifkgd";
const githubUrl = "https://github.com/manpuc/CharView-for-Google-Forms";
---

<Layout
    title="CharView - Works | manpuc"
    description="Details page for CharView: Character Counter for Google Forms + AI Autofill"
    lang="en"
>
    <div class="container main-content">
        <div class="back-nav animate-fade-up">
            <a href="/en/works/" class="back-link">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
                        points="12 19 5 12 12 5"></polyline></svg
                >
                Back to Works
            </a>
        </div>

        <header style="display: flex; flex-direction: column; align-items: flex-start; gap: 0; padding: 2.5rem 0 1.5rem;">
            <h1 class="animate-fade-up delay-1" style="margin: 0; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.2; letter-spacing: -0.02em;">
                CharView
            </h1>
            <p class="subtitle animate-fade-up delay-2" style="margin: 0.75rem 0 0; font-size: clamp(1.1rem, 2vw, 1.25rem); opacity: 0.8; font-weight: 500;">
                Character Counter for Google Forms + AI Autofill
            </p>
            <div class="tags animate-fade-up delay-3" style="margin-top: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <span class="tag" style="font-size: 0.85rem; padding: 0.3rem 0.8rem;">JavaScript</span>
                <span class="tag" style="font-size: 0.85rem; padding: 0.3rem 0.8rem;">Chrome Extension</span>
                <span class="tag" style="font-size: 0.85rem; padding: 0.3rem 0.8rem;">AI</span>
            </div>
            <div class="action-buttons animate-fade-up delay-4" style="display: flex; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap;">
                <a href={chromeWebStoreUrl} target="_blank" rel="noopener noreferrer" class="neumorph-btn" style="display: inline-flex; gap: 0.5rem; align-items: center; color: var(--primary);">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Add to Chrome
                </a>
                <span class="neumorph-btn" style="display: inline-flex; gap: 0.5rem; align-items: center; opacity: 0.5; cursor: not-allowed;" title="Private Repository">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                    View on GitHub
                </span>
            </div>
        </header>

        <div class="hero-image animate-fade-up delay-4" style="margin-bottom: 2.5rem; border-radius: var(--border-radius); overflow: hidden; box-shadow: var(--neumorph-shadow-sm);">
            <img src="https://lh3.googleusercontent.com/nePWApACsVScFKNfKY6CvHqsyzMgE-xR7sZKRHJn5YOH2NqZ4IDqHzeqYy_PglduyHSejAFczPwQYIxHe-P7d9qhIQ=rw-w512-h320" alt="CharView Screenshot" style="width: 100%; height: auto; display: block;" />
        </div>

        <section class="neumorph-card animate-fade-up delay-5" style="margin-bottom: 0;">
            <h2>Overview</h2>
            <p>
                A Chrome extension that displays character and word counts in real-time at the bottom right of Google Forms input fields. Useful for surveys, exams, and reports that have character limits.
            </p>
            <p>
                Additionally, it features an AI Autofill capability based on a <strong>BYOK (Bring Your Own Key)</strong> approach, allowing AI models (OpenAI, Gemini, Anthropic) to automatically fill out forms based on a custom prompt.
            </p>

            <h3 style="margin-top: 2rem;">Main Features & Characteristics</h3>
            <ul style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 0.75rem;">
                <li style="position: relative; padding-left: 1.75rem; line-height: 1.6;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0; top: 0.3rem;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <strong>Real-time Counter:</strong> Toggle between character and word counts. Advanced settings to include newlines, spaces, and punctuation.
                </li>
                <li style="position: relative; padding-left: 1.75rem; line-height: 1.6;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0; top: 0.3rem;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <strong>Target Count:</strong> Set a target count limit as a guideline for inputs.
                </li>
                <li style="position: relative; padding-left: 1.75rem; line-height: 1.6;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0; top: 0.3rem;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <strong>AI Autofill:</strong> Multi-provider support (OpenAI, Google Gemini, Anthropic). Flexible form filling based on custom instructions.
                </li>
                <li style="position: relative; padding-left: 1.75rem; line-height: 1.6;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0; top: 0.3rem;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <strong>Appearance & Theme:</strong> Auto / Light / Dark modes. "Enable Dark Mode for Google Forms" to darken the entire form page.
                </li>
                <li style="position: relative; padding-left: 1.75rem; line-height: 1.6;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0; top: 0.3rem;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <strong>Performance:</strong> Low Power Mode disables animations and blur for smoother operation.
                </li>
                <li style="position: relative; padding-left: 1.75rem; line-height: 1.6;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 0; top: 0.3rem;">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <strong>Localization:</strong> Multi-language support (i18n) for Japanese and English.
                </li>
            </ul>

            <h3 style="margin-top: 2rem;">Version History</h3>
            <div class="changelog-timeline" style="position: relative; padding-left: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1rem;">
                <div style="position: absolute; top: 0.5rem; bottom: 0.5rem; left: 6px; width: 2px; background-color: rgba(128, 128, 128, 0.2); z-index: 1;"></div>
                
                <div class="changelog-item" style="position: relative; z-index: 2;">
                    <div style="position: absolute; left: -1.5rem; top: 0.4rem; width: 12px; height: 12px; border-radius: 50%; background-color: var(--bg-color); border: 2px solid var(--primary); transform: translateX(1px); box-shadow: 0 0 0 2px var(--bg-color);"></div>
                    <div style="font-weight: 600; color: var(--text-color);">v1.3.5 <span style="font-size: 0.85em; color: var(--text-muted); margin-left: 0.5rem; font-weight: normal;">(2026/06/07)</span></div>
                    <div style="font-size: 0.95em; color: var(--text-muted); margin-top: 0.25rem;">Minor updates and internationalized privacy policy links.</div>
                </div>
                <div class="changelog-item" style="position: relative; z-index: 2;">
                    <div style="position: absolute; left: -1.5rem; top: 0.4rem; width: 12px; height: 12px; border-radius: 50%; background-color: var(--bg-color); border: 2px solid var(--primary); transform: translateX(1px); box-shadow: 0 0 0 2px var(--bg-color);"></div>
                    <div style="font-weight: 600; color: var(--text-color);">v1.3.3 <span style="font-size: 0.85em; color: var(--text-muted); margin-left: 0.5rem; font-weight: normal;">(2026/05/12)</span></div>
                    <div style="font-size: 0.95em; color: var(--text-muted); margin-top: 0.25rem;">Introduced a floating container and a toggle for AI button visibility.</div>
                </div>
                <div class="changelog-item" style="position: relative; z-index: 2;">
                    <div style="position: absolute; left: -1.5rem; top: 0.4rem; width: 12px; height: 12px; border-radius: 50%; background-color: var(--bg-color); border: 2px solid var(--primary); transform: translateX(1px); box-shadow: 0 0 0 2px var(--bg-color);"></div>
                    <div style="font-weight: 600; color: var(--text-color);">v1.2.0 <span style="font-size: 0.85em; color: var(--text-muted); margin-left: 0.5rem; font-weight: normal;">(2026/05/09)</span></div>
                    <div style="font-size: 0.95em; color: var(--text-muted); margin-top: 0.25rem;">Added i18n localization. Implemented AI autofill feature with multi-provider support, dark mode, and low power mode.</div>
                </div>
                <div class="changelog-item" style="position: relative; z-index: 2;">
                    <div style="position: absolute; left: -1.5rem; top: 0.4rem; width: 12px; height: 12px; border-radius: 50%; background-color: var(--bg-color); border: 2px solid var(--primary); transform: translateX(1px); box-shadow: 0 0 0 2px var(--bg-color);"></div>
                    <div style="font-weight: 600; color: var(--text-color);">v1.1.0 <span style="font-size: 0.85em; color: var(--text-muted); margin-left: 0.5rem; font-weight: normal;">(2026/04/30)</span></div>
                    <div style="font-size: 0.95em; color: var(--text-muted); margin-top: 0.25rem;">Added target count toggle and updated counter UI styling.</div>
                </div>
                <div class="changelog-item" style="position: relative; z-index: 2;">
                    <div style="position: absolute; left: -1.5rem; top: 0.4rem; width: 12px; height: 12px; border-radius: 50%; background-color: var(--bg-color); border: 2px solid var(--primary); transform: translateX(1px); box-shadow: 0 0 0 2px var(--bg-color);"></div>
                    <div style="font-weight: 600; color: var(--text-color);">v1.0.0 <span style="font-size: 0.85em; color: var(--text-muted); margin-left: 0.5rem; font-weight: normal;">(2026/04/17)</span></div>
                    <div style="font-size: 0.95em; color: var(--text-muted); margin-top: 0.25rem;">Initial release.</div>
                </div>
            </div>

            <div style="margin-top: 3rem; text-align: right;">
                <a href="/en/works/charview/privacy/" style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    Privacy Policy
                </a>
            </div>
        </section>
    </div>
</Layout>
