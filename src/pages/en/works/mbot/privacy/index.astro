---
import Layout from "../../../../../layouts/Layout.astro";
---

<Layout title="MBot Privacy Policy | manpuc" lang="en">
    <div class="container main-content">
        <div class="back-nav animate-fade-up">
            <a href="/en/works/mbot/" class="back-link">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
                        points="12 19 5 12 12 5"></polyline></svg
                >
                Back to MBot
            </a>
        </div>

        <header>
            <h1>MBot Privacy Policy</h1>
            <p class="subtitle">Privacy Policy</p>
        </header>

        <div class="neumorph-card animate-fade-up">
            <section style="margin-bottom: 2rem;">
                <p><strong>Last Updated:</strong> June 17, 2026</p>
                <p>
                    "MBot" (hereinafter referred to as the "Bot") respects user
                    privacy and strives to properly manage any acquired
                    information.
                </p>
            </section>

            <section style="margin-bottom: 2rem;">
                <h2>1. Information We Collect</h2>
                <p>
                    The Bot temporarily or restrictively collects the following
                    information via the Discord API to execute commands and
                    provide its features:
                </p>
                <ul>
                    <li>Server IDs, Channel IDs, and User IDs.</li>
                    <li>Command execution context and related message data.</li>
                </ul>
            </section>

            <section style="margin-bottom: 2rem;">
                <h2>2. Purpose of Use</h2>
                <p>
                    The collected information is used solely for the following
                    purposes:
                </p>
                <ul>
                    <li>
                        Processing requested commands and generating responses.
                    </li>
                    <li>
                        Analyzing error logs and improving the quality of the
                        Bot (in a non-personally identifiable format).
                    </li>
                </ul>
            </section>

            <section style="margin-bottom: 2rem;">
                <h2>3. Data Retention and Deletion</h2>
                <p>
                    The Bot does not permanently store chat contents or user
                    information, except for data essential to providing its
                    features (e.g., settings for specific features). Unnecessary
                    data is discarded promptly.
                </p>
            </section>

            <section style="margin-bottom: 2rem;">
                <h2>4. Disclosure to Third Parties</h2>
                <p>
                    We will not disclose or provide the acquired information to
                    third parties without prior consent, except as required by
                    law.
                </p>
            </section>

            <section>
                <h2>5. Contact Us</h2>
                <p>
                    If you have any questions regarding this Privacy Policy,
                    please contact us via email at <a
                        href="mailto:info@manpuc.me">info@manpuc.me</a
                    >.
                </p>
            </section>
        </div>
    </div>
</Layout>
