---
import Layout from "../../../../layouts/Layout.astro";
import { works } from "../../../../data/works";

const workId = "ore-multiplier";
const work = works.find((w) => w.id === workId);
const appUrl = work?.href || "https://modrinth.com/mod/ore-multiplier";

const structuredData = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: "ore-multiplier - Works | manpuc",
    description: "Details for ore-multiplier",
    url: "https://manpuc.me/en/works/ore-multiplier/",
    image: "https://manpuc.me/images/works/ore-multiplier/icon.webp",
    author: {
        "@type": "Person",
        name: "manpuc",
    },
};
---

<Layout
    image="/images/works/ore-multiplier/icon.webp"
    structuredData={structuredData}
    title={`${work?.title?.en || "Ore Multiplier"} - Works | manpuc`}
    description={work?.description?.en ||
        "Ore multiplier mod for Minecraft Forge 1.20.1"}
    lang="en"
>
    <div class="container main-content">
        <div class="back-nav animate-fade-up">
            <a href="/en/works/" class="back-link">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
                        points="12 19 5 12 12 5"></polyline></svg
                >
                Back to Works
            </a>
        </div>

        <header
            style="display: flex; flex-direction: column; align-items: flex-start; gap: 0; padding: 2.5rem 0 1.5rem;"
        >
            <h1
                class="animate-fade-up delay-1"
                style="margin: 0; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.2; letter-spacing: -0.02em;"
            >
                {work?.title?.en || "Ore Multiplier"}
            </h1>
            <p
                class="subtitle animate-fade-up delay-2"
                style="margin: 0.75rem 0 0; font-size: clamp(1.1rem, 2vw, 1.25rem); opacity: 0.8; font-weight: 500;"
            >
                Minecraft Forge Mod
            </p>
            {
                work?.tags && (
                    <div
                        class="tags animate-fade-up delay-3"
                        style="margin-top: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;"
                    >
                        {work.tags.map((tag) => (
                            <span
                                class="tag"
                                style="font-size: 0.85rem; padding: 0.3rem 0.8rem;"
                            >
                                {tag}
                            </span>
                        ))}
                    </div>
                )
            }
            <div
                class="action-buttons animate-fade-up delay-4"
                style="display: flex; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap;"
            >
                <a
                    href={appUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="neumorph-btn"
                    style="display: inline-flex; gap: 0.5rem; align-items: center; color: var(--primary);"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                        ></path><polyline points="15 3 21 3 21 9"
                        ></polyline><line x1="10" y1="14" x2="21" y2="3"
                        ></line></svg
                    >
                    Open Modrinth
                </a>
            </div>
        </header>

        <div
            class="hero-image animate-fade-up delay-4"
            style="margin-bottom: 2.5rem; border-radius: var(--border-radius); overflow: hidden; box-shadow: var(--neumorph-shadow-sm); position: relative; width: 100%; aspect-ratio: 21 / 9; display: flex; justify-content: center; align-items: center; background-color: var(--bg-color);"
        >
            <div
                style="position: absolute; inset: -40px; background-image: url('/images/works/ore-multiplier/icon.webp'); background-size: cover; background-position: center; filter: blur(30px); opacity: 0.5; z-index: 0;"
            >
            </div>
            <img
                src="/images/works/ore-multiplier/icon.webp"
                alt="Icon"
                style="position: relative; z-index: 1; height: 70%; width: auto; max-width: 100%; border-radius: 20%; box-shadow: 0 15px 35px rgba(0,0,0,0.3);"
            />
        </div>

        <section
            class="neumorph-card animate-fade-up delay-5"
            style="margin-bottom: 0;"
        >
            <h2>Overview</h2>
            <p>
                <strong>Ore Multiplier</strong> is an original mod developed for the
                Minecraft Forge (1.20.1) environment that dramatically improves mining
                efficiency. It introduces new items and systems that increase the
                drop rate when mining ore blocks.
            </p>

            <h3 style="margin-top: 2rem;">Key Features</h3>
            <ul
                style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 0.75rem;"
            >
                <li
                    style="position: relative; padding-left: 1.75rem; line-height: 1.6;"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="var(--primary)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="position: absolute; left: 0; top: 0.3rem;"
                        ><polyline points="20 6 9 17 4 12"></polyline></svg
                    >
                    <strong>Unique Mining System:</strong> Adds specialized tools
                    and mechanics that allow players to yield significantly more ores
                    than vanilla mining.
                </li>
                <li
                    style="position: relative; padding-left: 1.75rem; line-height: 1.6;"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="var(--primary)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="position: absolute; left: 0; top: 0.3rem;"
                        ><polyline points="20 6 9 17 4 12"></polyline></svg
                    >
                    <strong>Balanced Gameplay:</strong> Rather than being a simple
                    cheat, it requires satisfying specific conditions or costs to
                    earn the multiplied rewards, maintaining game balance.
                </li>
                <li
                    style="position: relative; padding-left: 1.75rem; line-height: 1.6;"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="var(--primary)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="position: absolute; left: 0; top: 0.3rem;"
                        ><polyline points="20 6 9 17 4 12"></polyline></svg
                    >
                    <strong>Forge 1.20.1 Compatibility:</strong> Fully optimized for
                    the modern Forge environment, running stably without conflicting
                    with other major mods.
                </li>
            </ul>

            <h3 style="margin-top: 2rem;">Version History</h3>
            <div
                class="changelog-timeline"
                style="position: relative; padding-left: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1rem;"
            >
                <div
                    style="position: absolute; top: 0.5rem; bottom: 0.5rem; left: 6px; width: 2px; background-color: rgba(128, 128, 128, 0.2); z-index: 1;"
                >
                </div>

                <div
                    class="changelog-item"
                    style="position: relative; z-index: 2;"
                >
                    <div
                        style="position: absolute; left: -1.5rem; top: 0.4rem; width: 12px; height: 12px; border-radius: 50%; background-color: var(--bg-color); border: 2px solid var(--primary); transform: translateX(1px); box-shadow: 0 0 0 2px var(--bg-color);"
                    >
                    </div>
                    <div style="font-weight: 600; color: var(--text-color);">
                        Initial Release <span
                            style="font-size: 0.85em; color: var(--text-muted); margin-left: 0.5rem; font-weight: normal;"
                            >(2023/11/04)</span>
                    </div>
                    <div
                        style="font-size: 0.95em; color: var(--text-muted); margin-top: 0.25rem;"
                    >
                        Project published.
                    </div>
                </div>
            </div>
        </section>
    </div>
</Layout>
